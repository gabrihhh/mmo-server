{
  "private": true,
  "name": "mmo-server",
  "version": "0.1.0",
  "description": "Servidor multiplayer do MMO (Node + ws)",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "mongodb": "^7.8.0",
    "ws": "^8.22.1"
  }
}
